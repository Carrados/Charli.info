// Publishing settings for the blind-ant Worker. `npm run publish` builds the site, copies the media from site/media.json
// into dist/media, then wrangler uploads dist as this Worker's static assets and deploys site/worker.js.
// The custom domains (blind-ant.com, www, dev) are attached in Cloudflare and stay as they are.
{
  "name": "blind-ant",
  "main": "blind-ant/site/worker.js",
  "compatibility_date": "2026-10-01",
  "account_id": "25fb70ed788c5f04f8bfba0688a3e24a",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist/blind-ant",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
