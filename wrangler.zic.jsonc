// Publishing settings for the zic Worker (zeroinformationcasualty.org). `npm run publish:zic` builds the site, then wrangler
// uploads dist/zic as this Worker's static assets and deploys zic/worker.js. The custom domains are attached in Cloudflare.
{
  "name": "zic",
  "main": "zic/worker.js",
  "compatibility_date": "2026-10-01",
  "account_id": "25fb70ed788c5f04f8bfba0688a3e24a",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist/zic",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
